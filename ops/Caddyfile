# goatcounter server on my local box
goatcounter.billmill.org {
	handle {
		reverse_proxy qfwfq:8080
	}

	log {
		output file /var/log/caddy/goatcounter-access.log {
			roll_size 10MB
			roll_keep 250
			roll_keep_for 90d
		}
	}
}

# immich server on my local box
immich.billmill.org {
	handle {
		reverse_proxy qfwfq:2283
	}

	log {
		output file /var/log/caddy/immich-access.log {
			roll_size 10MB
			roll_keep 250
			roll_keep_for 90d
		}
	}
}

# This website is a single index.html rn. I wanted to serve it directly out of
# the CDN bucket it's in, but that's actually not possible in digital ocean as
# far as I understand it. So, instead, this server is just redirecting to the
# CDN bucket as there's no static assets
#
# The LLM suggests adding:
# @static path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.json
# redir @static https://cdn.btree.space{uri} permanent
#
# if we do actually get static assets
btree.space {
	rewrite / /index.html

	reverse_proxy https://cdn.btree.space {
		header_up Host cdn.btree.space
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 250
			roll_keep_for 90d
		}
	}
}
# Default caddyfile folllows:
# :80

# Set this path to your site's directory.
# root * /usr/share/caddy

# Enable the static file server.
# file_server

# Another common task is to set up a reverse proxy:
# reverse_proxy localhost:8080

# Or serve a PHP site through php-fpm:
# php_fastcgi localhost:9000

