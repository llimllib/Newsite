# The Caddyfile is an easy way to configure your Caddy web server.
#
# Unless the file starts with a global options block, the first
# uncommented line is always the address of your site.
#
# To use your own domain name (with automatic HTTPS), first make
# sure your domain's A/AAAA DNS records are properly pointed to
# this machine's public IP, then replace the line below with your
# domain name.
beta.billmill.org, billmill.org {
	root * /var/www/html/
	file_server

	# These are the github repos I have which have gh-pages branches; I
	# foolishly used github to host them for a long time under the billmill.org
	# domain and now I have to redirect them to keep the URLs alive
	@old_github_url {
		path_regexp old_github_url ^\/((?:champsleagueviz|bloomfilter-tutorial|roundbracket|solving-sol|ncaa-bracket-randomizer|pymag-trees|fantasypl|ratesoccer|lichesstree|magahat|aiclass|Extractotron|covidgraph).*)
	}
	redir @old_github_url https://llimllib.github.io/{http.regexp.old_github_url.1}

	# proxy HMDA api and add CORS
	handle_path /hmdaproxy/* {
		reverse_proxy {
			to https://ffiec.cfpb.gov
			# if we don't set this, the ELB rejects our request with a 503
			header_up Host "ffiec.cfpb.gov"
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET,POST"
			header_down Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept"
		}
	}

	# proxy github pages to add CORS
	handle_path /ghproxy/* {
		reverse_proxy {
			to https://llimllib.github.io
			# if we don't set this, the ELB rejects our request with a 503
			header_up Host "llimllib.github.io"
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET,POST"
			header_down Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept"
		}
	}

	# proxy to Digital Ocean Spaces for NBA data with clean URLs
	handle /nba* {
		@nba_exact path /nba
		redir @nba_exact /nba/ permanent

		uri strip_prefix /nba

		# Root path gets index.html (handles both empty path and /)
		@root {
			path /
			path ""
		}
		rewrite @root /index.html

		# Directory paths get index.html appended
		@dir {
			path */
			not path /
		}
		rewrite @dir {path}index.html

		# Clean URLs get .html extension added
		@noext {
			not path /
			not path */
			not path *.*
		}
		rewrite @noext {path}.html

		reverse_proxy https://nba-data.sfo3.cdn.digitaloceanspaces.com {
			header_up Host nba-data.sfo3.cdn.digitaloceanspaces.com
		}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 250
			roll_keep_for 90d
		}
	}
}

# https://caddyserver.com/docs/quick-starts/reverse-proxy
# To make this a localhost subdomain work in Safari, I had to add
# `127.0.0.1 journal.localhost` to /etc/hosts
journal.beta.billmill.org, journal.billmill.org {
	reverse_proxy {$JOURNAL:127.0.0.1:11111}
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 250
			roll_keep_for 90d
		}
	}
}

# proxy requests to notes.billmill.org to my CDN
# * https://caddyserver.com/docs/caddyfile/directives/reverse_proxy#headers
notes.billmill.org {
	# the CDN won't serve index.html at /, so treat it specially
	rewrite / /obsidian_html/index.html

	# otherwise, just prepend the bucket and return the file
	rewrite * /obsidian_html{path}

	reverse_proxy https://cdn.billmill.org {
		header_up Host {upstream_hostport}
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 250
			roll_keep_for 90d
		}
	}
}

